{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "public/r/**",
        "public/pagefind/**",
        "public/docs/**",
        "public/docs.md",
        "public/index.md",
        "public/llms.txt",
        "public/llms-full.txt"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "@grenishrai/expressive#test": {
      "dependsOn": [
        "@expressive/registry#build"
      ]
    },
    "@grenishrai/expressive#build": {
      "dependsOn": [
        "@expressive/registry#build"
      ],
      "outputs": [
        "dist/**"
      ]
    }
  }
}
