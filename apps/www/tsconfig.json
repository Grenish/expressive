{
  "extends": "../../tooling/tsconfig.base.json",
  "compilerOptions": {
    "allowJs": false,
    "jsx": "preserve",
    "incremental": true,
    "noUnusedLocals": false,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/registry/*": ["../../packages/registry/src/*"],
      "@/*": ["./*"],
      "@expressive/manifest": ["../../packages/registry/registry.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "../../packages/registry/src/**/*.ts", "../../packages/registry/src/**/*.tsx"],
  "exclude": ["node_modules"]
}
